{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"types": ["node", "vite/client"]
	},
	"include": ["src", "tests/**/*.ts", "vite.config.ts"]
}
